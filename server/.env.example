# Express Server Port
PORT=5000

# Supabase Credentials (Dapatkan dari: Supabase Dashboard -> Project Settings -> API)
# URL Project Anda (contoh: https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Anon Public Key atau Service Role Key Supabase
SUPABASE_KEY=your-supabase-anon-key-here

# Client URL untuk CORS
CLIENT_URL=http://localhost:8443

